+void LoopingFileCastAgent::EmitEvent(std::string_view event,
+                                     std::string_view fields) {
+  if (!connection_settings_ || connection_settings_->event_fd < 0) {
+    return;
+  }
+  std::string line = fields.empty()
+                         ? std::format(R"({{"api":1,"event":"{}"}})", event)
+                         : std::format(
+                               R"({{"api":1,"event":"{}",{}}})", event,
+                               fields);
+  line.push_back('\n');
+  const char* cursor = line.data();
+  size_t remaining = line.size();
+  while (remaining > 0) {
+    const ssize_t written =
+        write(connection_settings_->event_fd, cursor, remaining);
+    if (written > 0) {
+      cursor += written;
+      remaining -= static_cast<size_t>(written);
+    } else if (written < 0 && errno == EINTR) {
+      continue;
+    } else {
+      break;
+    }
+  }
+}
